# Configuration contract from docs/project-plan.md §6. Values stay EMPTY in this file.
# Copy to an ignored local file (for example .env.provider.local or .env.agent.local)
# and fill values there. Comments show the plan's baseline defaults.

# Databases
DATABASE_URL=
EVALUATOR_DATABASE_URL=

# Provider credentials (secrets: never commit)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
USDA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Runtime selection
# baseline: anthropic
VISION_PROVIDER=
# confirm with a real smoke test (Prompt 19)
VISION_MODEL=
# baseline: grounded
PIPELINE_MODE=
# baseline: US
REGION=
# baseline: en
LANGUAGE=

# Storage and provider-output policy
# baseline: local
IMAGE_STORAGE_MODE=
# baseline: 30
IMAGE_RETENTION_DAYS=
# baseline: false (until fatsecret rights are confirmed in writing)
PERSIST_PROVIDER_OUTPUTS=
# baseline: pending
PROVIDER_OUTPUT_POLICY_VERSION=

# Safety limits
# baseline: false (true enables paid live calls)
ENABLE_LIVE_API_TESTS=
# baseline: 8
MAX_EXTERNAL_ATTEMPTS_PER_SCAN=
# baseline: 2
MAX_MODEL_CALLS_PER_SCAN=
# baseline: 45
MAX_SCAN_SECONDS=
