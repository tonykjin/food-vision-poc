# Pilot login proxy (POC-16). Every request needs a username and password; passwords are stored
# only as hashes in users.caddy (git-ignored, created with scripts/pilot-user.ps1). TLS comes from
# the tunnel in front of this proxy; the proxy itself listens on the private compose network.
{
	admin off
	auto_https off
}

:8080 {
	request_body {
		max_size 11MB
	}

	basic_auth {
		import /etc/caddy/users.caddy
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /app-a* {
		reverse_proxy a-ui:8501
	}

	handle /app-b* {
		reverse_proxy b-ui:8502
	}

	handle / {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Food Vision POC</title>
			<style>body{font-family:system-ui,sans-serif;max-width:40rem;margin:3rem auto;padding:0 1rem;line-height:1.5;color:#1f2937}
			a.app{display:block;padding:1rem;margin:.75rem 0;border:1px solid #d1d5db;border-radius:.5rem;text-decoration:none;color:inherit}
			a.app:hover{border-color:#6b7280}.note{font-size:.9rem;color:#4b5563}</style></head>
			<body><h1>Food Vision proof of concept</h1>
			<p>Upload one meal photo to either app to get an estimated nutrition breakdown.</p>
			<a class="app" href="/app-a/"><strong>App A</strong> - fatsecret image recognition</a>
			<a class="app" href="/app-b/"><strong>App B</strong> - vision model + USDA food data</a>
			<p class="note">Proof of concept: results are estimates, not measured accuracy. Uploaded photos are not stored.
			Each scan calls paid third-party APIs.</p></body></html>
			HTML 200
	}

	handle {
		respond "Not found" 404
	}
}
