{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/*.env)",
      "Read(/**/secrets/**)",
      "Read(/**/.secrets/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/**/credentials*.json)",
      "Read(/**/service-account*.json)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/*.env)",
      "Edit(/**/secrets/**)",
      "Edit(/**/.secrets/**)",
      "Edit(/**/*.pem)",
      "Edit(/**/*.key)",
      "Edit(/**/credentials*.json)",
      "Edit(/**/service-account*.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
