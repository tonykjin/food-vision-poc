# Configuration contract from docs/project-plan.md §6. Values stay EMPTY in this file.
# Copy to an ignored local file (for example .env.provider.local or .env.agent.local)
# and fill values there. Comments show the plan's baseline defaults.

# Databases
# Inference login (member of fv_inference). Never an owner/superuser URL.
DATABASE_URL=
# Evaluator login (member of fv_evaluator). Never in .env.provider.local or .env.agent.local.
EVALUATOR_DATABASE_URL=
# Owner role for `alembic upgrade head` only; set in your shell, not in app env files.
MIGRATION_DATABASE_URL=

# Provider credentials (secrets: never commit)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
USDA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Runtime selection
# baseline: anthropic
VISION_PROVIDER=
# confirm with a real smoke test (Prompt 19)
VISION_MODEL=
# baseline: grounded
PIPELINE_MODE=
# baseline: US
REGION=
# baseline: en
LANGUAGE=

# Storage and provider-output policy
# baseline: local
IMAGE_STORAGE_MODE=
# baseline: 30
IMAGE_RETENTION_DAYS=
# baseline: false (until fatsecret rights are confirmed in writing)
PERSIST_PROVIDER_OUTPUTS=
# baseline: pending
PROVIDER_OUTPUT_POLICY_VERSION=

# App mode and UI wiring (POC-02)
# baseline: false. true = synthetic MOCK results, no provider or model calls
MOCK_MODE=
# UIs only; default http://127.0.0.1:8001 (A) and http://127.0.0.1:8002 (B)
PROVIDER_API_URL=
AGENT_API_URL=

# Safety limits
# baseline: false (true enables paid live calls)
ENABLE_LIVE_API_TESTS=
# baseline: 8
MAX_EXTERNAL_ATTEMPTS_PER_SCAN=
# baseline: 2
MAX_MODEL_CALLS_PER_SCAN=
# baseline: 45
MAX_SCAN_SECONDS=
# optional dollar cap per scan; empty = no cap (unknown costs stay unknown)
MAX_SCAN_COST_USD=
